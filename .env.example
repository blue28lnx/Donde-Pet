# === Google OAuth ===
# Consiguelo en: console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=

# === Firebase (Authentication + Firestore) ===
# Consiguelo en: console.firebase.google.com → Project Settings → General → Your apps
# Sin estos valores, los datos NO se sincronizan entre usuarios (cae al fallback localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
