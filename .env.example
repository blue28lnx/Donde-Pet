# Client ID de Google OAuth (Web Application)
# Consiguelo en: console.cloud.google.com → APIs & Services → Credentials
# Sin este valor, la app funciona en modo DEMO (login simulado).
VITE_GOOGLE_CLIENT_ID=

# (Opcional) Si más adelante agregás Firebase u otra API key pública:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
